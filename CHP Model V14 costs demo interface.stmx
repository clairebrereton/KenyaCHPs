*under_5_diarrhoea_incidence[area] *diarrhoea_treatment_demand_proportion
/ person_per_urgent_visit</eqn>
				</element>
				<element subscript="under_five_diarrhoea_treatment, Uasin_Gishu">
					<eqn>(population_by_age_group_area[under_1,area] + population_by_age_group_area[&quot;1_to_4&quot;,area])
