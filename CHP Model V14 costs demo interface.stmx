	<isee:sensi_specs_list active_index="1">
		<isee:sensi_specs name="Sensitivity to visit frequency " method="multivariate" runs="5">
			<isee:variable starting_value="6" ending_value="11" type="incremental" min="6" max="11" seed="12345" name="visit_frequency" num_samples="10"/>
		</isee:sensi_specs>
		<isee:sensi_specs name="Sensitivity to motivation influencers" method="sobol_sequence" runs="50">
			<isee:variable type="triangular" lower="0.0002" upper="0.0008" mode="0.0005" min="0.0002" max="0.0008" seed="12345" name="effect_of_trust_on_motivation" num_samples="5"/>
			<isee:variable type="triangular" lower="0.0002" upper="0.0008" mode="0.0005" min="0.0002" max="0.0008" name="effect_of_supplies_on_motivation" num_samples="5"/>
		</isee:sensi_specs>
		<isee:sensi_specs name="Sensitivity to poverty multiplier" method="sobol_sequence" runs="50">
			<isee:variable type="triangular" lower="1.5" upper="2" mode="1.75" min="1.5" max="2" seed="12345" name="pop.proportion_poverty_CHP_usage_rate_multiplier" num_samples="7"/>
		</isee:sensi_specs>
