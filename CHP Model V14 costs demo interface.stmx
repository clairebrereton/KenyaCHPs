			<aux name="initial proportion of\ncounty pop by age group" ai_state="F">
				<dimensions>
					<dim name="age_group"/>
					<dim name="county"/>
				</dimensions>
				<eqn>initial_population_by_age_group_county[age_group,county]
/(initial_population_by_age_group_county[under_1,county]
+initial_population_by_age_group_county[&quot;1_to_4&quot;,county]
+initial_population_by_age_group_county[&quot;5_to_14&quot;,county]
+initial_population_by_age_group_county[&quot;15_to_64_general&quot;,county]
+initial_population_by_age_group_county[women_15_to_49,county]
+initial_population_by_age_group_county[&quot;65_and_over&quot;,county])</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="pop multiplier by age group Kenya" ai_state="B">
				<dimensions>
					<dim name="age_group"/>
				</dimensions>
				<eqn>population_by_age_group_Kenya[age_group]/INIT(population_by_age_group_Kenya[age_group])</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="pop growth\nproportion by area" ai_state="B" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>population_by_area/initial_population_by_area</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="diarrhoea duration" ai_state="B">
				<eqn>0.027397260274</eqn>
				<units>year</units>
			</aux>
			<aux name="target household visit\ndemand per year by area" ai_state="B" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>SUM(target_community_demand_per_year_for_household_visits_by_service_and_area[*,area])</eqn>
				<units>household/year</units>
			</aux>
			<stock name="Community trust" ai_state="B" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>0.9</eqn>
				<inflow>trust_change</inflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<flow name="trust change" ai_state="D">
				<doc>SMTH1(2.5*(PREVIOUS(unmet.unmet_demand_by_area, unmet.unmet_demand_by_area)
- unmet.unmet_demand_by_area[area]),3)



SMTH1(50*(PREVIOUS(unmet.unmet_demand_proportion_of_target_by_area, unmet.unmet_demand_proportion_of_target_by_area)
- unmet.unmet_demand_proportion_of_target_by_area),trust_change_lead_time)


SMTH1(5*(PREVIOUS(unmet.unmet_demand_by_area, unmet.unmet_demand_by_area)
- unmet.unmet_demand_by_area[area])
/
PREVIOUS(unmet.unmet_demand_by_area, unmet.unmet_demand_by_area),trust_change_lead_time)

0.03*(INIT(unmet.unmet_demand_proportion_of_target_by_area) -unmet.unmet_demand_proportion_of_target_by_area)

</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>IF TIME &gt; 2025 THEN effect_of_unmet_demand_on_trust_change*(HISTORY(unmet_demand_proportion_by_area, 2020,1)
-unmet_demand_proportion_by_area)
ELSE 0</eqn>
				<units>1/year</units>
			</flow>
