				<connect2 to="unmet.CHP_emergency_first_aid_injuries_service" from="CHP_emergency_first_aid_injuries_service"/>
				<connect to="unmet.CHP_emergency_first_aid_injuries_service_1" from=".CHP_emergency_first_aid_injuries_service"/>
				<connect2 to="unmet.CHP_emergency_first_aid_injuries_service_1" from="CHP_emergency_first_aid_injuries_service"/>
				<connect to="unmet.CHP_fever_visit_service" from=".CHP_fever_visit_service"/>
				<connect2 to="unmet.CHP_fever_visit_service" from="CHP_fever_visit_service"/>
				<connect to="unmet.CHP_fever_visit_service_1" from=".CHP_fever_visit_service"/>
				<connect2 to="unmet.CHP_fever_visit_service_1" from="CHP_fever_visit_service"/>
				<connect to="unmet.CHP_malaria_testing_service" from="maltrt.CHP_malaria_testing_service"/>
				<connect2 to="unmet.CHP_malaria_testing_service" from="maltrt.CHP_malaria_testing_service"/>
				<connect to="unmet.CHP_malaria_treatment_service" from="maltrt.CHP_malaria_treatment_service"/>
				<connect2 to="unmet.CHP_malaria_treatment_service" from="maltrt.CHP_malaria_treatment_service"/>
				<connect to="unmet.CHP_routine_household_visits_per_year" from=".CHP_routine_household_visits_per_year"/>
				<connect2 to="unmet.CHP_routine_household_visits_per_year" from="CHP_routine_household_visits_per_year"/>
				<connect to="unmet.CHP_routine_household_visits_per_year_1" from=".CHP_routine_household_visits_per_year"/>
				<connect2 to="unmet.CHP_routine_household_visits_per_year_1" from="CHP_routine_household_visits_per_year"/>
				<connect to="unmet.CHP_under_five_diarrhoea_treatment_service" from=".CHP_under_five_diarrhoea_treatment_service"/>
				<connect2 to="unmet.CHP_under_five_diarrhoea_treatment_service" from="CHP_under_five_diarrhoea_treatment_service"/>
				<connect to="unmet.CHP_under_five_diarrhoea_visit_service" from=".CHP_under_five_diarrhoea_visit_service"/>
				<connect2 to="unmet.CHP_under_five_diarrhoea_visit_service" from="CHP_under_five_diarrhoea_visit_service"/>
				<connect to="unmet.CHP_under_five_diarrhoea_visit_service_1" from=".CHP_under_five_diarrhoea_visit_service"/>
				<connect2 to="unmet.CHP_under_five_diarrhoea_visit_service_1" from="CHP_under_five_diarrhoea_visit_service"/>
				<connect to="unmet.community_handling_all" from="mal.community_handling_all"/>
				<connect2 to="unmet.community_handling_all" from="mal.community_handling_all"/>
				<connect to="unmet.community_handling_lake_endemic" from="mal.community_handling_lake_endemic"/>
				<connect2 to="unmet.community_handling_lake_endemic" from="mal.community_handling_lake_endemic"/>
				<connect to="unmet.community_handling_lake_endemic_coastal_endemic_and_Turkana" from="mal.community_handling_lake_endemic_coastal_endemic_and_Turkana"/>
				<connect2 to="unmet.community_handling_lake_endemic_coastal_endemic_and_Turkana" from="mal.community_handling_lake_endemic_coastal_endemic_and_Turkana"/>
				<connect to="unmet.cut_down_service_unit_needs_per_year_by_area" from=".cut_down_service_unit_needs_per_year_by_area"/>
				<connect2 to="unmet.cut_down_service_unit_needs_per_year_by_area" from="cut_down_service_unit_needs_per_year_by_area"/>
				<connect to="unmet.diarrhoea_prevalence_all_ages" from=".diarrhoea_prevalence_all_ages"/>
				<connect2 to="unmet.diarrhoea_prevalence_all_ages" from="diarrhoea_prevalence_all_ages"/>
				<connect to="unmet.diarrhoea_treatment_demand_proportion" from=".diarrhoea_treatment_demand_proportion"/>
				<connect2 to="unmet.diarrhoea_treatment_demand_proportion" from="diarrhoea_treatment_demand_proportion"/>
				<connect to="unmet.emergency_household_visit_equivalent_multiplier" from=".emergency_household_visit_equivalent_multiplier"/>
				<connect2 to="unmet.emergency_household_visit_equivalent_multiplier" from="emergency_household_visit_equivalent_multiplier"/>
				<connect to="unmet.household_size" from=".household_size"/>
				<connect2 to="unmet.household_size" from="household_size"/>
				<connect to="unmet.initial_community_handling_capability" from="mal.initial_community_handling_capability"/>
				<connect2 to="unmet.initial_community_handling_capability" from="mal.initial_community_handling_capability"/>
				<connect to="unmet.malaria_policy_implementation_date" from="mal.malaria_policy_implementation_date"/>
				<connect2 to="unmet.malaria_policy_implementation_date" from="mal.malaria_policy_implementation_date"/>
				<connect to="unmet.no_community_handling" from="mal.no_community_handling"/>
				<connect2 to="unmet.no_community_handling" from="mal.no_community_handling"/>
				<connect to="unmet.people_in_age_group_per_household" from=".people_in_age_group_per_household"/>
				<connect2 to="unmet.people_in_age_group_per_household" from="people_in_age_group_per_household"/>
				<connect to="unmet.person_per_urgent_visit" from="pop.person_per_urgent_visit"/>
				<connect2 to="unmet.person_per_urgent_visit" from="pop.person_per_urgent_visit"/>
				<connect to="unmet.positive_proportion_of_malaria_cases" from=".positive_proportion_of_malaria_cases"/>
				<connect2 to="unmet.positive_proportion_of_malaria_cases" from="positive_proportion_of_malaria_cases"/>
				<connect to="unmet.proportion_willing_to_use_CHPs" from="pop.proportion_willing_to_use_CHPs"/>
				<connect2 to="unmet.proportion_willing_to_use_CHPs" from="pop.proportion_willing_to_use_CHPs"/>
				<connect to="unmet.proportion_of_supplies_available" from=".proportion_of_supplies_available"/>
				<connect2 to="unmet.proportion_of_supplies_available" from="proportion_of_supplies_available"/>
				<connect to="unmet.proportion_of_hh_visits_requiring_supplies" from=".proportion_of_hh_visits_requiring_supplies"/>
				<connect2 to="unmet.proportion_of_hh_visits_requiring_supplies" from="proportion_of_hh_visits_requiring_supplies"/>
			</module>
			<aux name="factors affecting motivation" ai_state="D">
				<doc>(morale*pay_and_reliability
*unmet.workload_proportion)</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>effect_of_trust_on_motivation*(Community_trust-1) +
effect_of_supplies_on_motivation*(MIN(1, proportion_of_supplies_available[general]-0.5)) +
effect_of_pay_reliability_on_motivation*pay_reliability</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="standard recruitment %" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>7</eqn>
				<units>1/year</units>
			</aux>
			<module name="Costs" isee:label="Costs module" ai_state="B">
				<connect to="Costs.CHP_demand_by_area" from="pop.CHP_demand_by_area"/>
				<connect2 to="Costs.CHP_demand_by_area" from="pop.CHP_demand_by_area"/>
				<connect to="Costs.CHP_deworming_visit_service" from=".children_dewormed"/>
				<connect2 to="Costs.CHP_deworming_visit_service" from="children_dewormed"/>
				<connect to="Costs.CHPs_by_area" from=".CHPs_by_area"/>
				<connect2 to="Costs.CHPs_by_area" from="CHPs_by_area"/>
				<connect to="Costs.new_CHP_inflow" from=".new_CHP_inflow"/>
				<connect2 to="Costs.new_CHP_inflow" from="new_CHP_inflow"/>
				<connect to="Costs.population_by_area" from="pop.population_by_area"/>
				<connect2 to="Costs.population_by_area" from="pop.population_by_area"/>
				<connect to="Costs.proportion_of_supplies_available" from=".proportion_of_supplies_available"/>
				<connect2 to="Costs.proportion_of_supplies_available" from="proportion_of_supplies_available"/>
				<connect to="Costs.training_start_year" from=".training_start_year"/>
				<connect2 to="Costs.training_start_year" from="training_start_year"/>
				<connect to="Costs.training_and_supervision_investment_hours_per_CHP_per_year" from=".training_and_supervision_investment_hours_per_CHP_per_year"/>
				<connect2 to="Costs.training_and_supervision_investment_hours_per_CHP_per_year" from="training_and_supervision_investment_hours_per_CHP_per_year"/>
			</module>
			<aux name="population by area" ai_state="D" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>SUM(pop.population_by_age_group_area[*,area])
- pop.population_by_age_group_area[women_15_to_49,area]</eqn>
				<units>person</units>
			</aux>
			<aux name="CHPs per 1000 pop" ai_state="D">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>1000*CHP_number_by_area_2025/population_by_area</eqn>
				<units>CHP/person</units>
			</aux>
			<module name="mal" isee:label="Malaria prevalence
 module" ai_state="F">
				<connect to=".community_handling_capability" from="mal.community_handling_capability"/>
				<connect2 to="community_handling_capability" from="mal.community_handling_capability"/>
				<connect to="maltrt.community_handling_capability_1" from="mal.community_handling_capability"/>
				<connect2 to="maltrt.community_handling_capability_1" from="mal.community_handling_capability"/>
				<connect to="unmet.community_handling_all" from="mal.community_handling_all"/>
				<connect2 to="unmet.community_handling_all" from="mal.community_handling_all"/>
				<connect to="unmet.community_handling_lake_endemic" from="mal.community_handling_lake_endemic"/>
				<connect2 to="unmet.community_handling_lake_endemic" from="mal.community_handling_lake_endemic"/>
				<connect to="unmet.community_handling_lake_endemic_coastal_endemic_and_Turkana" from="mal.community_handling_lake_endemic_coastal_endemic_and_Turkana"/>
				<connect2 to="unmet.community_handling_lake_endemic_coastal_endemic_and_Turkana" from="mal.community_handling_lake_endemic_coastal_endemic_and_Turkana"/>
				<connect to="unmet.initial_community_handling_capability" from="mal.initial_community_handling_capability"/>
				<connect2 to="unmet.initial_community_handling_capability" from="mal.initial_community_handling_capability"/>
				<connect to="unmet.malaria_policy_implementation_date" from="mal.malaria_policy_implementation_date"/>
				<connect2 to="unmet.malaria_policy_implementation_date" from="mal.malaria_policy_implementation_date"/>
				<connect to="pop.malaria_testing_forecast_full_community_demand" from="mal.malaria_testing_forecast_full_demand"/>
				<connect2 to="pop.malaria_testing_forecast_full_community_demand" from="mal.malaria_testing_forecast_full_demand"/>
				<connect to="pop.malaria_treatment_forecast_full_community_demand" from="mal.malaria_treatment_forecast_full_demand"/>
				<connect2 to="pop.malaria_treatment_forecast_full_community_demand" from="mal.malaria_treatment_forecast_full_demand"/>
				<connect to="unmet.no_community_handling" from="mal.no_community_handling"/>
				<connect2 to="unmet.no_community_handling" from="mal.no_community_handling"/>
				<connect to=".suspected_malaria_cases_total_reported_in_community" from="mal.suspected_malaria_cases_total_reported_in_community"/>
				<connect2 to="suspected_malaria_cases_total_reported_in_community" from="mal.suspected_malaria_cases_total_reported_in_community"/>
				<connect to="mal.CHP_valid_malaria_treatment_service_1" from="maltrt.CHP_valid_malaria_treatment_service"/>
				<connect2 to="mal.CHP_valid_malaria_treatment_service_1" from="maltrt.CHP_valid_malaria_treatment_service"/>
				<connect to="mal.population_by_area" from=".population_by_area"/>
				<connect2 to="mal.population_by_area" from="population_by_area"/>
				<connect to="mal.positive_proportion_of_malaria_cases" from=".positive_proportion_of_malaria_cases"/>
				<connect2 to="mal.positive_proportion_of_malaria_cases" from="positive_proportion_of_malaria_cases"/>
			</module>
			<aux name="training and\nsupervision investment\nhours per CHP per year" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>5</eqn>
				<units>1/year</units>
			</aux>
			<flow name="competency attrition" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>TIME</eqn>
				<non_negative/>
				<gf>
					<yscale min="0.00006" max="0.02"/>
					<xpts>2024,2025.6,2027.2,2028.8,2030.4,2032,2033.6,2035.2,2036.8,2038.4,2040</xpts>
					<ypts>0.02,0.02,0.02,0.00887,0.00635,0.00465,0.0034,0.0022,0.00151,0.00082,0.00006</ypts>
				</gf>
				<units>1/year</units>
			</flow>
			<aux name="CHP initial household\nvisits per year" ai_state="F">
				<doc>1 initial service unit = 1 hour CHP time
Initial capacity = 24 hours per week x 48 weeks per year = </doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>visit_frequency*target_households[area]/CHP_per_visit</eqn>
				<units>household/(CHP*year)</units>
			</aux>
			<aux name="training\nstart year" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>2027</eqn>
				<format precision="1" scale_by="1"/>
				<units>year</units>
			</aux>
			<aux name="recruitment\nstart year" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>2026</eqn>
				<format precision="1" scale_by="1"/>
				<units>year</units>
			</aux>
			<aux name="additional recruitment %" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>0</eqn>
				<units>1/year</units>
			</aux>
			<aux name="training performance\nper hour\nmultiplier" ai_state="F">
				<doc>used 0.0004 in Dr Maureen demo</doc>
				<eqn>0.0007</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="proportion of\nsupplies\navailable" ai_state="B">
				<dimensions>
					<dim name="supplies"/>
				</dimensions>
				<eqn>percentage_of_supplies_available_by_service[supplies]/100</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="Community trust" ai_state="D" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>0.9</eqn>
				<units>dmnl</units>
			</stock>
			<aux name="pay reliability" ai_state="B">
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="CHP fever visit capacity" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_capacity_per_year_in_household_visits[area] - CHP_emergency_first_aid_injuries_service[area]</eqn>
				<units>household/year</units>
			</aux>
			<aux name="CHP fever visit\nservice" ai_state="D">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>MIN(actual_service_unit_demand_per_year_by_service_and_area[malaria_testing,area], CHP_fever_visit_capacity[area])</eqn>
				<units>household/year</units>
			</aux>
			<aux name="positive proportion\nof malaria cases" ai_state="F" access="output" isee:autocreated="true">
				<doc>get realistic value. This based on Omondi et al average doi: 10.1371/journal.pgph.0001532

Now based on KHIS CHEW Malaria test positivity rate (by RDT)</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<element subscript="Kenya">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Kakamega">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Butere">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Mumias_West">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Shinyalu">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Nairobi">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Kibra">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Turkana">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Turkana_West">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Suguta">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Uasin_Gishu">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Kapseret">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Soy">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Turbo">
					<eqn>0.4</eqn>
				</element>
				<units>dmnl</units>
			</aux>
			<aux name="CHP numbers\n2025\nequivalent" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHPs_by_area*CHP_productivity</eqn>
				<units>CHP</units>
			</aux>
			<aux name="cut down service unit needs\nper year by area" ai_state="D" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>SUM(target_community_demand_per_year_for_household_visits_by_service_and_area[*,area])</eqn>
				<units>household/year</units>
			</aux>
			<aux name="estimated demand in\nCHP 2025 equivalent" ai_state="D">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>cut_down_service_unit_needs_per_year_by_area[area]
/CHP_initial_household_visits_per_year[area]</eqn>
				<units>CHP</units>
			</aux>
			<aux name="CHP productivity" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_performance</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="CHP initial productivity" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>1.1</eqn>
				<units>dmnl</units>
			</aux>
			<module name="hsh" isee:label="Household visits
module" ai_state="B">
				<connect to="hsh.CHP_emergency_first_aid_injuries_service_1" from=".CHP_emergency_first_aid_injuries_service"/>
				<connect2 to="hsh.CHP_emergency_first_aid_injuries_service_1" from="CHP_emergency_first_aid_injuries_service"/>
				<connect to="hsh.CHP_fever_visit_service" from=".CHP_fever_visit_service"/>
				<connect2 to="hsh.CHP_fever_visit_service" from="CHP_fever_visit_service"/>
				<connect to="hsh.CHP_routine_household_visits_per_year" from=".CHP_routine_household_visits_per_year"/>
				<connect2 to="hsh.CHP_routine_household_visits_per_year" from="CHP_routine_household_visits_per_year"/>
				<connect to="hsh.emergency_household_visit_equivalent_multiplier" from=".emergency_household_visit_equivalent_multiplier"/>
				<connect2 to="hsh.emergency_household_visit_equivalent_multiplier" from="emergency_household_visit_equivalent_multiplier"/>
				<connect to="hsh.population_by_area_1" from=".population_by_area"/>
				<connect2 to="hsh.population_by_area_1" from="population_by_area"/>
			</module>
			<aux name="CHP NCD screening\nservice" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_routine_household_visits_per_year[area]
*(people_in_age_group_per_household[&quot;15_to_64_general&quot;,area]+people_in_age_group_per_household[&quot;65_and_over&quot;,area])
*proportion_of_hh_visits_requiring_supplies[general,area]
*proportion_of_supplies_available[general]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="CHP under five\nassessments" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_assessments_per_year_by_age_group[under_1,area]
+
CHP_assessments_per_year_by_age_group[&quot;1_to_4&quot;,area]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="CHP over five\nassessments" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_assessments_per_year_by_age_group[&quot;5_to_14&quot;,area]
+
CHP_assessments_per_year_by_age_group[&quot;15_to_64_general&quot;,area]
+
CHP_assessments_per_year_by_age_group[&quot;65_and_over&quot;,area]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="CHP emergency\ntreatment service" ai_state="D">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_emergency_first_aid_injuries_service[area]
*person_per_urgent_visit
*proportion_of_hh_visits_requiring_supplies[general,area]
*proportion_of_supplies_available[general]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="actual service unit demand per\nyear by service and area" ai_state="D" access="input">
				<doc>Assume if using reported in the community that these are people willing to use CHPs? </doc>
				<dimensions>
					<dim name="service"/>
					<dim name="area"/>
				</dimensions>
				<eqn>target_community_demand_per_year_for_household_visits_by_service_and_area[service,area]*
proportion_willing_to_use_CHPs[area]</eqn>
				<units>household/year</units>
			</aux>
			<aux name="children dewormed" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_routine_household_visits_per_year[area]
*(people_in_age_group_per_household[&quot;1_to_4&quot;,area]+people_in_age_group_per_household[&quot;5_to_14&quot;,area])
*proportion_of_hh_visits_requiring_supplies[deworming,area]
*proportion_of_supplies_available[deworming]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="percentage\nof supplies available" ai_state="F">
				<doc>Malaria testing exception case
IF service=service.malaria_testing THEN 0 </doc>
				<eqn>100</eqn>
				<units>dmnl</units>
			</aux>
