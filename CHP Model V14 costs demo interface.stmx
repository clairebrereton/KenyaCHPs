			<aux name="people in age group per household" ai_state="D">
				<dimensions>
					<dim name="age_group"/>
					<dim name="area"/>
				</dimensions>
				<eqn>proportion_by_age_group_area[age_group,area]*household_size[area]</eqn>
				<units>person/household</units>
			</aux>
			<aux name="CHP assessments per year by age group" ai_state="B">
				<doc>IF CHP_deworming_capacity[Butere] &gt;= CHP_service_contact_backlog[deworming,Butere]
THEN
    IF CHP_service_contact_backlog[deworming,Butere] &gt;= 
    Subcounty_supplies[deworming,Butere]
    THEN Subcounty_supplies[deworming,Butere]
    ELSE CHP_service_contact_backlog[deworming,Butere]
ELSE 
   IF  CHP_deworming_capacity[Butere] &gt;= 
Subcounty_supplies[deworming,Butere]
   THEN Subcounty_supplies[deworming,Butere]
   ELSE CHP_deworming_capacity[Butere]


IF (CHP_deworming_capacity[Butere] &gt;= CHP_service_contact_backlog[deworming,Butere])
THEN
    IF (CHP_service_contact_backlog[deworming,Butere] &gt;= 
    Subcounty_supplies[deworming,Butere])
    THEN Subcounty_supplies[deworming,Butere]
    ELSE CHP_service_contact_backlog[deworming,Butere]
ELSE 
   IF  (CHP_deworming_capacity[Butere] &gt;= 
Subcounty_supplies[deworming,Butere])
   THEN Subcounty_supplies[deworming,Butere]
   ELSE CHP_deworming_capacity[Butere]</doc>
				<dimensions>
					<dim name="age_group"/>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_routine_household_visits_per_year[area]
*assessment_proportion_per_visit_by_age_group[age_group]
*people_in_age_group_per_household[age_group,area]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="household size" ai_state="B" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>5</eqn>
				<units>person/household</units>
			</aux>
			<module name="pop" isee:label="Population and service need module" ai_state="F">
				<connect to="unmet.actual_household_visit_demand_per_year_by_area" from="pop.actual_household_visit_demand_per_year_by_area"/>
				<connect2 to="unmet.actual_household_visit_demand_per_year_by_area" from="pop.actual_household_visit_demand_per_year_by_area"/>
				<connect to=".actual_service_unit_demand_per_year_by_service_and_area" from="pop.actual_household_visit_demand_per_year_by_service_and_area"/>
