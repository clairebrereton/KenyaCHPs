	<model name="pop">
		<variables>
			<aux name="initial population by area" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<element subscript="Kenya">
					<eqn>48817537</eqn>
				</element>
				<element subscript="Kakamega">
					<eqn>1897460</eqn>
				</element>
				<element subscript="Butere">
					<eqn>156566</eqn>
				</element>
				<element subscript="Mumias_West">
					<eqn>117196</eqn>
				</element>
				<element subscript="Shinyalu">
					<eqn>170319</eqn>
				</element>
				<element subscript="Nairobi">
					<eqn>4502603</eqn>
				</element>
				<element subscript="Kibra">
					<eqn>185777</eqn>
				</element>
