					<eqn>100</eqn>
				</element>
				<element subscript="Kibra">
					<eqn>100</eqn>
				</element>
				<element subscript="Turkana">
					<eqn>35</eqn>
				</element>
				<element subscript="Turkana_West">
					<eqn>35</eqn>
				</element>
				<element subscript="Suguta">
					<eqn>35</eqn>
				</element>
				<element subscript="Uasin_Gishu">
					<eqn>100</eqn>
				</element>
				<element subscript="Kapseret">
					<eqn>100</eqn>
				</element>
				<element subscript="Soy">
					<eqn>100</eqn>
				</element>
				<element subscript="Turbo">
					<eqn>100</eqn>
				</element>
				<units>household</units>
			</aux>
			<aux name="percentage\nof supplies available\nby service" ai_state="B">
				<doc>Malaria testing exception case
IF service=service.malaria_testing THEN 0 </doc>
				<dimensions>
					<dim name="supplies"/>
				</dimensions>
				<eqn>percentage_of_supplies_available</eqn>
				<units>dmnl</units>
			</aux>
