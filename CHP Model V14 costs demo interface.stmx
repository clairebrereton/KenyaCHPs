				<eqn>1</eqn>
				<units>CHP</units>
			</aux>
			<aux name="suspected malaria\ncases total reported\nin community" ai_state="C" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>NAN</eqn>
				<units>case</units>
			</aux>
			<aux name="pop growth\nproportion by area" ai_state="C" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>population_by_area/initial_population_by_area</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="unmet need households\ndue to lack of CHP trust" ai_state="G" access="input">
				<doc>pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_emergency_first_aid_injuries_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_emergency_first_aid_injuries_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_malaria_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_diarrhoea_under_5_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_diarrhoea_over_5_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_attendance_neonatal_and_under_1[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_child_checkups_and_deworming[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_NCD_screening_referrals_and_misc[area]</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>cut_down_service_unit_needs_per_year_by_area
*(1-proportion_willing_to_use_CHPs)</eqn>
				<units>household/year</units>
			</aux>
			<aux name="community\nhandling capability" ai_state="G" access="input">
				<doc>IF TIME &lt;2027
THEN initial_community_handling_capability
ELSE 0.9</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="person per urgent visit" ai_state="G" access="input">
				<eqn>1</eqn>
				<units>person/household</units>
			</aux>
			<module name="maltrt" isee:label="Malaria test and 
treat module" ai_state="F">
				<connect to="unmet.CHP_malaria_testing_service" from="maltrt.CHP_malaria_testing_service"/>
				<connect2 to="unmet.CHP_malaria_testing_service" from="maltrt.CHP_malaria_testing_service"/>
				<connect to="unmet.CHP_malaria_treatment_service" from="maltrt.CHP_malaria_treatment_service"/>
				<connect2 to="unmet.CHP_malaria_treatment_service" from="maltrt.CHP_malaria_treatment_service"/>
				<connect to="mal.CHP_valid_malaria_treatment_service_1" from="maltrt.CHP_valid_malaria_treatment_service"/>
				<connect2 to="mal.CHP_valid_malaria_treatment_service_1" from="maltrt.CHP_valid_malaria_treatment_service"/>
				<connect to="maltrt.CHP_fever_visit_service" from=".CHP_fever_visit_service"/>
				<connect2 to="maltrt.CHP_fever_visit_service" from="CHP_fever_visit_service"/>
				<connect to="maltrt.community_handling_capability_1" from="mal.community_handling_capability"/>
				<connect2 to="maltrt.community_handling_capability_1" from="mal.community_handling_capability"/>
				<connect to="maltrt.person_per_urgent_visit_1" from=".person_per_urgent_visit"/>
				<connect2 to="maltrt.person_per_urgent_visit_1" from="person_per_urgent_visit"/>
				<connect to="maltrt.proportion_of_supplies_available" from=".proportion_of_supplies_available"/>
				<connect2 to="maltrt.proportion_of_supplies_available" from="proportion_of_supplies_available"/>
				<connect to="maltrt.proportion_of_hh_visits_requiring_supplies" from=".proportion_of_hh_visits_requiring_supplies"/>
				<connect2 to="maltrt.proportion_of_hh_visits_requiring_supplies" from="proportion_of_hh_visits_requiring_supplies"/>
			</module>
			<aux name="CHP under five\ndiarrhoea treatment\ncapacity" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_fever_visit_capacity[area] -
 CHP_fever_visit_service[area]</eqn>
				<units>household/year</units>
			</aux>
			<aux name="CHP under five\ndiarrhoea treatment\nservice" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_under_five_diarrhoea_visit_service[area]
*proportion_of_hh_visits_requiring_supplies[diarrhoea,area]
*proportion_of_supplies_available[diarrhoea]
*person_per_urgent_visit</eqn>
				<units>person/year</units>
			</aux>
			<aux name="CHP under five\ndiarrhoea visit\nservice" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>MIN(actual_service_unit_demand_per_year_by_service_and_area[under_five_diarrhoea_treatment,area], 
CHP_under_five_diarrhoea_treatment_capacity)</eqn>
				<units>household/year</units>
			</aux>
			<aux name="CHP antenatal and under 1 year old assessments" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_assessments_per_year_by_age_group[under_1,area]*1.5</eqn>
				<units>person/year</units>
			</aux>
			<aux name="CHP demand by area" ai_state="F">
				<dimensions>
					<dim name="area" marked_a2a="true"/>
					<dim name="demand"/>
				</dimensions>
				<element subscript="Kenya, supply">
					<eqn>CHP_numbers_2025_equivalent[area]</eqn>
				</element>
				<element subscript="Kenya, gap">
					<eqn>MAX(estimated_demand_in_CHP_2025_equivalent[area]-CHP_numbers_2025_equivalent[area],0)</eqn>
				</element>
				<element subscript="Kenya, trust">
					<eqn>unmet_need_households_due_to_lack_of_CHP_trust[area]/CHP_initial_household_visits_per_year[area]</eqn>
				</element>
				<element subscript="Kakamega, supply">
					<eqn>CHP_numbers_2025_equivalent[area]</eqn>
				</element>
				<element subscript="Kakamega, gap">
					<eqn>MAX(estimated_demand_in_CHP_2025_equivalent[area]-CHP_numbers_2025_equivalent[area],0)</eqn>
				</element>
				<element subscript="Kakamega, trust">
					<eqn>unmet_need_households_due_to_lack_of_CHP_trust[area]/CHP_initial_household_visits_per_year[area]</eqn>
				</element>
				<element subscript="Butere, supply">
					<eqn>CHP_numbers_2025_equivalent[area]</eqn>
				</element>
				<element subscript="Butere, gap">
					<eqn>MAX(estimated_demand_in_CHP_2025_equivalent[area]-CHP_numbers_2025_equivalent[area],0)</eqn>
				</element>
				<element subscript="Butere, trust">
					<eqn>unmet_need_households_due_to_lack_of_CHP_trust[area]/CHP_initial_household_visits_per_year[area]</eqn>
				</element>
				<element subscript="Mumias_West, supply">
					<eqn>CHP_numbers_2025_equivalent[area]</eqn>
				</element>
				<element subscript="Mumias_West, gap">
					<eqn>MAX(estimated_demand_in_CHP_2025_equivalent[area]-CHP_numbers_2025_equivalent[area],0)</eqn>
				</element>
				<element subscript="Mumias_West, trust">
					<eqn>unmet_need_households_due_to_lack_of_CHP_trust[area]/CHP_initial_household_visits_per_year[area]</eqn>
				</element>
				<element subscript="Shinyalu, supply">
					<eqn>CHP_numbers_2025_equivalent[area]</eqn>
				</element>
				<element subscript="Shinyalu, gap">
					<eqn>MAX(estimated_demand_in_CHP_2025_equivalent[area]-CHP_numbers_2025_equivalent[area],0)</eqn>
				</element>
				<element subscript="Shinyalu, trust">
					<eqn>unmet_need_households_due_to_lack_of_CHP_trust[area]/CHP_initial_household_visits_per_year[area]</eqn>
				</element>
				<element subscript="Nairobi, supply">
