	<model_units>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
			<alias>fraction</alias>
		</unit>
		<unit name="People">
			<eqn/>
			<alias>person</alias>
			<alias>persons</alias>
		</unit>
		<unit name="Years">
			<eqn/>
			<alias>yr</alias>
			<alias>year</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<aux name="CHP emergency first\naid injuries service" ai_state="D">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>MIN(actual_service_unit_demand_per_year_by_service_and_area[emergency_and_first_aid,area], 
CHP_capacity_per_year_in_household_visits[area])</eqn>
				<units>household/year</units>
			</aux>
			<aux name="CHP capacity\nper year in\nhousehold visits" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHPs_by_area
*CHP_initial_household_visits_per_year
*CHP_productivity</eqn>
				<units>household/year</units>
			</aux>
			<stock name="CHPs\nby area" ai_state="F">
				<doc>Assumption - 90% of 2025 CHP numbers at model start in 2020.</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_number_by_area_2025</eqn>
				<inflow>new_CHP_inflow</inflow>
				<outflow>attrition</outflow>
				<non_negative/>
				<units>CHP</units>
			</stock>
			<flow name="new CHP inflow" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>area_recruitment_rate*(CHPs_by_area)/(100)</eqn>
				<non_negative/>
				<units>CHP/year</units>
			</flow>
			<flow name="attrition" ai_state="D">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>IF TIME &lt;2025
THEN 0
ELSE 
&quot;attrition_%&quot;*CHPs_by_area/100</eqn>
				<non_negative/>
				<units>CHP/year</units>
			</flow>
			<aux name="attrition %" ai_state="B">
				<doc>From Sakari et al for Kakamega county</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>7</eqn>
				<units>1/year</units>
			</aux>
			<aux name="area recruitment rate" ai_state="D">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>IF TIME &lt;2025
THEN 0
ELSE 
IF TIME &gt;=recruitment_start_year
THEN &quot;standard_recruitment_%&quot; + &quot;additional_recruitment_%&quot;
ELSE &quot;standard_recruitment_%&quot;</eqn>
				<units>1/year</units>
			</aux>
			<stock name="CHP performance" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_initial_productivity</eqn>
				<inflow>motivation_change</inflow>
				<inflow>competency_increase</inflow>
				<outflow>competency_attrition</outflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<flow name="motivation change" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>factors_affecting_motivation/DT</eqn>
				<units>1/year</units>
			</flow>
			<flow name="competency increase" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>IF TIME &gt;=training_start_year
THEN training_and_supervision_investment_hours_per_CHP_per_year *training_performance_per_hour_multiplier
ELSE 0</eqn>
				<non_negative/>
				<units>1/year</units>
			</flow>
			<aux name="CHP routine\nhousehold\nvisits per year" ai_state="D">
				<doc>MIN((pop.actual_service_unit_demand_per_year_by_service_and_area[neonatal_and_under_1_checks,area]+pop.actual_service_unit_demand_per_year_by_service_and_area[child_checks_under_5_deworming_diarrhoea,area]
+pop.actual_service_unit_demand_per_year_by_service_and_area[child_checks_5_to_14_deworming_diarrhoea,area]
+pop.actual_service_unit_demand_per_year_by_service_and_area[adult_visits_15_to_64_NCDs_WaSH_education,area]
+pop.actual_service_unit_demand_per_year_by_service_and_area[over_65_visits_NCDs_education,area]), 
CHP_routine_service_capacity[area])</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>MIN(CHP_routine_household_visit_capacity[area], 
actual_service_unit_demand_per_year_by_service_and_area[routine_visit,area])</eqn>
				<units>household/year</units>
			</aux>
			<aux name="CHP over five\ndiarrhoea treatment\nservice" ai_state="H">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_routine_household_visits_per_year
*diarrhoea_prevalence_all_ages
*household_size*(1-(proportion_by_age_group_area[under_1,area]+proportion_by_age_group_area[&quot;1_to_4&quot;,area]))
*diarrhoea_treatment_demand_proportion
*proportion_of_supplies_available[diarrhoea]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="CHP routine household\nvisit capacity" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_under_five_diarrhoea_treatment_capacity
 -
CHP_under_five_diarrhoea_visit_service</eqn>
				<units>household/year</units>
			</aux>
			<aux name="CHP average age\nby area 2025" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<element subscript="Kenya">
					<eqn>NAN</eqn>
				</element>
				<element subscript="Kakamega">
					<eqn>0</eqn>
				</element>
				<element subscript="Butere">
					<eqn>52</eqn>
				</element>
				<element subscript="Mumias_West">
					<eqn>49</eqn>
				</element>
				<element subscript="Shinyalu">
					<eqn>52</eqn>
				</element>
				<element subscript="Nairobi">
					<eqn>NAN</eqn>
				</element>
				<element subscript="Kibra">
					<eqn>NAN</eqn>
				</element>
				<element subscript="Turkana">
					<eqn>NAN</eqn>
				</element>
				<element subscript="Turkana_West">
					<eqn>NAN</eqn>
				</element>
				<element subscript="Suguta">
					<eqn>NAN</eqn>
				</element>
				<element subscript="Uasin_Gishu">
					<eqn>NAN</eqn>
				</element>
				<element subscript="Kapseret">
					<eqn>52</eqn>
				</element>
				<element subscript="Soy">
					<eqn>0</eqn>
				</element>
				<element subscript="Turbo">
					<eqn>0</eqn>
				</element>
				<units>years</units>
			</aux>
			<aux name="CHP average education level\nby area 2025" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>NAN</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="CHP number by area 2025" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<element subscript="Kenya">
					<eqn>111576</eqn>
				</element>
				<element subscript="Kakamega">
					<eqn>4317</eqn>
				</element>
				<element subscript="Butere">
					<eqn>430</eqn>
