			<aux name="poverty rate by area" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<element subscript="Kenya">
					<eqn>0.398</eqn>
				</element>
				<element subscript="Kakamega">
					<eqn>0.333</eqn>
				</element>
				<element subscript="Butere">
					<eqn>0.345</eqn>
				</element>
				<element subscript="Mumias_West">
					<eqn>0.154</eqn>
				</element>
				<element subscript="Shinyalu">
					<eqn>0.644</eqn>
				</element>
				<element subscript="Nairobi">
					<eqn>0.167</eqn>
				</element>
				<element subscript="Kibra">
					<eqn>0.66</eqn>
				</element>
				<element subscript="Turkana">
					<eqn>0.827</eqn>
				</element>
				<element subscript="Turkana_West">
					<eqn>0.821</eqn>
				</element>
				<element subscript="Suguta">
					<eqn>0.999</eqn>
				</element>
				<element subscript="Uasin_Gishu">
					<eqn>0.388</eqn>
				</element>
				<element subscript="Kapseret">
					<eqn>0.348</eqn>
				</element>
				<element subscript="Soy">
					<eqn>0.086</eqn>
				</element>
				<element subscript="Turbo">
					<eqn>0.355</eqn>
				</element>
				<units>dmnl</units>
			</aux>
			<aux name="proportion by\nage group area" ai_state="B" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="age_group"/>
					<dim name="area"/>
				</dimensions>
				<eqn>population_by_age_group_area[age_group,area]
/ population_by_area[area]</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="target proportion using CHPs" ai_state="B">
				<doc>Kakamega 2 lowest are
0.175+0.362 = 0.537
Poverty rate =0.333. Use 2 lowest quintiles = 

so say roughly subcounty poverty rate * 1.5

Uasin Gishu 2 lowest are 
0.032 + 0.166 = 0.198
Poverty rate = 0.404
so say roughly subcounty poverty rate * 1.5

Data from KHDS 2022 Kenya = 20% + 10%</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>IF poverty_rate_by_area&gt;0.8 THEN 
MIN(0.95, poverty_rate_by_area*1.5)
ELSE
MIN(0.9, poverty_rate_by_area*proportion_poverty_CHP_usage_rate_multiplier)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="actual household visit\ndemand per year by service and area" ai_state="B" access="output" isee:autocreated="true">
				<doc>Assume if using reported in the community that these are people willing to use CHPs? </doc>
				<dimensions>
					<dim name="service"/>
					<dim name="area"/>
				</dimensions>
				<eqn>target_community_demand_per_year_for_household_visits_by_service_and_area[service,area]*
proportion_willing_to_use_CHPs[area]</eqn>
				<units>household/year</units>
			</aux>
			<aux name="unmet demand by area 1" ai_state="B" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>person/year</units>
			</aux>
			<aux name="emergency visits per 1000 people" ai_state="B">
				<eqn>3</eqn>
				<units>1/year</units>
			</aux>
			<aux name="household size" ai_state="F" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<element subscript="Kenya">
					<eqn>3.9</eqn>
				</element>
				<element subscript="Kakamega">
					<eqn>4.3</eqn>
				</element>
				<element subscript="Butere">
					<eqn>4.3</eqn>
				</element>
				<element subscript="Mumias_West">
					<eqn>4.3</eqn>
				</element>
				<element subscript="Shinyalu">
					<eqn>4.3</eqn>
				</element>
				<element subscript="Nairobi">
					<eqn>2.9</eqn>
				</element>
				<element subscript="Kibra">
					<eqn>2.9</eqn>
				</element>
				<element subscript="Turkana">
					<eqn>5.6</eqn>
				</element>
				<element subscript="Turkana_West">
					<eqn>5.6</eqn>
				</element>
				<element subscript="Suguta">
					<eqn>5.6</eqn>
				</element>
				<element subscript="Uasin_Gishu">
					<eqn>3.8</eqn>
				</element>
				<element subscript="Kapseret">
					<eqn>3.8</eqn>
				</element>
				<element subscript="Soy">
					<eqn>3.8</eqn>
				</element>
				<element subscript="Turbo">
					<eqn>3.8</eqn>
				</element>
				<units>person/household</units>
			</aux>
			<aux name="pregnancy labour\nvisits per birth" ai_state="B">
				<eqn>1.26</eqn>
				<units>1/year</units>
			</aux>
			<aux name="unmet demand proportion\nby area" ai_state="D" access="input">
				<doc>(unmet_demand_by_area+unmet_need_households_due_to_lack_of_CHP_trust)/
pop.target_household_visit_demand_per_year_by_area</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="person per urgent visit" ai_state="B" access="output" isee:autocreated="true">
				<eqn>1</eqn>
				<units>person/household</units>
			</aux>
			<aux name="actual household visit\ndemand per year by area" ai_state="B" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>SUM(actual_household_visit_demand_per_year_by_service_and_area[*,area])</eqn>
				<units>household/year</units>
			</aux>
			<aux name="emergency household\nvisit equivalent multiplier" ai_state="B" access="input">
				<eqn>5</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="proportion poverty\nCHP usage rate multiplier" ai_state="B">
				<eqn>1.75</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="effect of unmet demand on trust change" ai_state="B">
				<eqn>0.04</eqn>
				<units>1/year</units>
			</aux>
			<aux name="desired visit frequency" ai_state="F">
				<eqn>9</eqn>
				<units>1/year</units>
			</aux>
			<aux name="under 5 diarrhoea prevalence" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<units>dmnl</units>
			</aux>
			<aux name="under 5 diarrhoea incidence" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>under_5_diarrhoea_prevalence/under_5_diarrhoea_duration</eqn>
				<units>1/year</units>
			</aux>
			<aux name="under 5 diarrhoea duration" ai_state="F">
				<eqn>0.0191780821917808</eqn>
				<units>year</units>
			</aux>
			<aux name="diarrhoea treatment demand proportion" ai_state="F" access="input">
				<eqn>0.5</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="CHP demand\nby area" ai_state="F" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>population_by_area*
target_proportion_using_CHPs</eqn>
				<units>person</units>
			</aux>
		</variables>
