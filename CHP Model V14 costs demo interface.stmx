			</aux>
			<aux name="CHP NCD screening history" ai_state="B">
				<doc>+HISTORY(CHP_diabetes_screening, TIME, 3)</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>IF TIME &lt; 2026 
THEN 
HISTORY(CHP_hypertension_screening,TIME, 3)
+
+HISTORY(CHP_diabetes_screening, TIME, 3)

ELSE NAN</eqn>
				<units>person/year</units>
			</aux>
			<aux name="effect of trust on motivation" ai_state="F">
				<doc>0.0003 in Dr Maureen demo</doc>
