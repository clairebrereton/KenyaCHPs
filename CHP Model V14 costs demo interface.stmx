			</aux>
			<aux name="unmet demand in households visited\ndue to CHP resource gap" ai_state="H" access="output" isee:autocreated="true">
				<doc>pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_emergency_first_aid_injuries_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_emergency_first_aid_injuries_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_malaria_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_diarrhoea_under_5_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_diarrhoea_over_5_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_attendance_neonatal_and_under_1[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_child_checkups_and_deworming[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_NCD_screening_referrals_and_misc[area]


IF 
pop.actual_household_visit_demand_per_year_by_area &gt;
 .CHP_capacity_per_year_in_household_visits

THEN 
(pop.actual_household_visit_demand_per_year_by_area - .CHP_capacity_per_year_in_household_visits)
*pop.household_size/.visit_frequency

ELSE 0</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>MAX((actual_household_visit_demand_per_year_by_area[area] - CHP_capacity), 0)</eqn>
				<units>household/year</units>
			</aux>
			<aux name="unmet need households\ndue to lack of CHP trust" ai_state="H" access="output" isee:autocreated="true">
				<doc>pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_emergency_first_aid_injuries_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_emergency_first_aid_injuries_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_malaria_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_diarrhoea_under_5_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_diarrhoea_over_5_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_attendance_neonatal_and_under_1[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_child_checkups_and_deworming[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_NCD_screening_referrals_and_misc[area]</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>cut_down_service_unit_needs_per_year_by_area
*(1-proportion_willing_to_use_CHPs)</eqn>
				<units>household/year</units>
			</aux>
			<aux name="cut down service unit needs\nper year by area" ai_state="B" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>household/year</units>
			</aux>
			<aux name="proportion\nwilling to use CHPs" ai_state="D" access="input">
				<doc>Kakamega 2 lowest are
0.175+0.362 = 0.537
Poverty rate =0.333. Use 2 lowest quintiles = 

so say roughly subcounty poverty rate * 1.5

Uasin Gishu 2 lowest are 
0.032 + 0.166 = 0.198
Poverty rate = 0.404
so say roughly subcounty poverty rate * 1.5

Data from KHDS 2022 Kenya = 20% + 10%</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="unmet demand due to\nsupplies gap" ai_state="H" access="output" isee:autocreated="true">
				<doc>pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_emergency_first_aid_injuries_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_emergency_first_aid_injuries_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
-    .CHP_malaria_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_diarrhoea_under_5_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_diarrhoea_over_5_treatment_service[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_attendance_neonatal_and_under_1[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_child_checkups_and_deworming[area]

pop.cut_down_service_unit_needs_per_year_by_service_and_area
- .CHP_NCD_screening_referrals_and_misc[area]



+ (.CHP_under_five_diarrhoea_visit_service - .CHP_under_five_diarrhoea_treatment_service) *pop.person_per_urgent_visit
</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>SAFEDIV(CHP_emergency_first_aid_injuries_service[area]
*proportion_of_hh_visits_requiring_supplies[general,area]
*person_per_urgent_visit
*(1-proportion_of_supplies_available[general])
, emergency_household_visit_equivalent_multiplier)

+ malaria_supplies_demand_gap

+under_five_diarrhoea_supplies_gap

+CHP_routine_household_visits_per_year[area]
*(people_in_age_group_per_household[&quot;1_to_4&quot;,area]+people_in_age_group_per_household[&quot;5_to_14&quot;,area])
*proportion_of_hh_visits_requiring_supplies[deworming,area]
*(1-proportion_of_supplies_available[deworming])

+CHP_routine_household_visits_per_year[area]
*(people_in_age_group_per_household[&quot;15_to_64_general&quot;,area]+people_in_age_group_per_household[&quot;65_and_over&quot;,area])
*proportion_of_hh_visits_requiring_supplies[general,area]
*(1-proportion_of_supplies_available[general])

+CHP_routine_household_visits_per_year[area]
*household_size[area]
*diarrhoea_prevalence_all_ages[area]*diarrhoea_treatment_demand_proportion
*(1-proportion_of_supplies_available[general])</eqn>
				<units>person/year</units>
			</aux>
			<aux name="positive proportion\nof malaria cases" ai_state="D" access="input">
				<doc>get realistic value. This based on Omondi et al average doi: 10.1371/journal.pgph.0001532

Now based on KHIS CHEW Malaria test positivity rate (by RDT)</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="unmet demand by area" ai_state="D" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>unmet_demand_in_households_visited_due_to_CHP_resource_gap * household_size
+
MAX(unmet_demand_due_to_supplies_gap, 0)</eqn>
				<units>person/year</units>
			</aux>
			<aux name="malaria supplies\ndemand gap" ai_state="F">
				<doc>IF .proportion_of_supplies_available[malaria_treat] =1 THEN 0
ELSE</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn> malaria_test_supplies_demand_gap+malaria_treatment_supplies_demand_gap</eqn>
				<units>person/year</units>
			</aux>
			<aux name="proportion of hh visits\nrequiring supplies" ai_state="D" access="input">
				<doc>Items per case for child checks/deworming reduced to 0.75 becauase not all 1 to 4 year old visits require deworming. 

Items per visit for diarrhoea = prevalence i.e. if a diarrhoea infection is encountered when a CHP visits then the CHP offers treatment if they have it available. Multiplier put in as this will not be unique to education visits. 


0
1
1
0.25
0
0.75
0.25</doc>
				<dimensions>
					<dim name="supplies"/>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="proportion of\nsupplies\navailable" ai_state="B" access="input">
				<dimensions>
					<dim name="supplies"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="CHP routine\nhousehold\nvisits per year" ai_state="D" access="input">
				<doc>MIN((pop.actual_service_unit_demand_per_year_by_service_and_area[neonatal_and_under_1_checks,area]+pop.actual_service_unit_demand_per_year_by_service_and_area[child_checks_under_5_deworming_diarrhoea,area]
+pop.actual_service_unit_demand_per_year_by_service_and_area[child_checks_5_to_14_deworming_diarrhoea,area]
+pop.actual_service_unit_demand_per_year_by_service_and_area[adult_visits_15_to_64_NCDs_WaSH_education,area]
+pop.actual_service_unit_demand_per_year_by_service_and_area[over_65_visits_NCDs_education,area]), 
CHP_routine_service_capacity[area])</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>household/year</units>
			</aux>
			<aux name="people in age group per household" ai_state="B" access="input">
				<dimensions>
					<dim name="age_group"/>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>person/household</units>
			</aux>
			<aux name="household size" ai_state="B" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>person/household</units>
			</aux>
			<aux name="unmet demand\nproportion of target\nby area" ai_state="D" access="output" isee:autocreated="true">
				<doc>(unmet_demand_by_area+unmet_need_households_due_to_lack_of_CHP_trust)/
pop.target_household_visit_demand_per_year_by_area</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>(unmet_demand_by_area)/
(cut_down_service_unit_needs_per_year_by_area*household_size)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="person per urgent visit" ai_state="B" access="input">
				<eqn>1</eqn>
				<units>person/household</units>
			</aux>
			<aux name="actual household visit\ndemand per year by area" ai_state="B" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>household/year</units>
			</aux>
			<aux name="emergency household\nvisit equivalent multiplier" ai_state="B" access="input">
				<eqn>5</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="malaria test supplies\ndemand gap" ai_state="H">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>(CHP_fever_visit_service[area]*person_per_urgent_visit
*community_handling_capability[area])
-CHP_malaria_testing_service[area]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="malaria treatment supplies\ndemand gap" ai_state="H">
				<doc>(maltrt.CHP_malaria_testing_service
*.positive_proportion_of_malaria_cases[area])
-maltrt.CHP_malaria_testing_service[area]
+
(.CHP_fever_visit_service[area]*pop.person_per_urgent_visit
*community_handling_capability)
-maltrt.CHP_malaria_treatment_service[area]</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>(CHP_malaria_testing_service[area]
*positive_proportion_of_malaria_cases[area])
-CHP_malaria_treatment_service[area]
+
(CHP_fever_visit_service[area]*person_per_urgent_visit
*community_handling_capability[area])
-CHP_malaria_testing_service[area]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="diarrhoea prevalence all ages" ai_state="B" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="diarrhoea treatment demand proportion" ai_state="B" access="input">
				<eqn>0.5</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="community handling capability" ai_state="C">
				<doc>Community handling capability for the unmet module. Replicates mal.community handling capability logic per area element.</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<element subscript="Kenya">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF (community_handling_lake_endemic_coastal_endemic_and_Turkana=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.31 ELSE IF (no_community_handling=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0 ELSE IF (community_handling_all=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Kakamega">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1 THEN initial_community_handling_capability ELSE IF (no_community_handling=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0 ELSE IF community_handling_all=1 THEN initial_community_handling_capability ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Butere">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1 THEN initial_community_handling_capability ELSE IF (no_community_handling=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0 ELSE IF community_handling_all=1 THEN initial_community_handling_capability ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Mumias_West">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1 THEN initial_community_handling_capability ELSE IF (no_community_handling=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0 ELSE IF community_handling_all=1 THEN initial_community_handling_capability ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Shinyalu">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1 THEN initial_community_handling_capability ELSE IF (no_community_handling=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0 ELSE IF community_handling_all=1 THEN initial_community_handling_capability ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Nairobi">
					<eqn>IF community_handling_lake_endemic=1 THEN 0 ELSE IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1 THEN 0 ELSE IF no_community_handling=1 THEN 0 ELSE IF (community_handling_all=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Kibra">
					<eqn>IF community_handling_lake_endemic=1 THEN 0 ELSE IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1 THEN 0 ELSE IF no_community_handling=1 THEN 0 ELSE IF (community_handling_all=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Turkana">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF (community_handling_lake_endemic_coastal_endemic_and_Turkana=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE IF no_community_handling=1 THEN 0 ELSE IF (community_handling_all=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Turkana_West">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF (community_handling_lake_endemic_coastal_endemic_and_Turkana=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE IF no_community_handling=1 THEN 0 ELSE IF (community_handling_all=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Suguta">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF (community_handling_lake_endemic_coastal_endemic_and_Turkana=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE IF no_community_handling=1 THEN 0 ELSE IF (community_handling_all=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Uasin_Gishu">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1 THEN initial_community_handling_capability ELSE IF no_community_handling=1 THEN 0 ELSE IF (community_handling_all=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Kapseret">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1 THEN initial_community_handling_capability ELSE IF no_community_handling=1 THEN 0 ELSE IF (community_handling_all=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Soy">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1 THEN initial_community_handling_capability ELSE IF no_community_handling=1 THEN 0 ELSE IF (community_handling_all=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Turbo">
					<eqn>IF community_handling_lake_endemic=1 THEN initial_community_handling_capability ELSE IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1 THEN initial_community_handling_capability ELSE IF no_community_handling=1 THEN 0 ELSE IF (community_handling_all=1 AND TIME&gt;=malaria_policy_implementation_date) THEN 0.9 ELSE initial_community_handling_capability</eqn>
				</element>
				<units>dmnl</units>
			</aux>
			<aux name="community handling lake endemic" ai_state="C" access="input">
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="community handling lake endemic coastal endemic and Turkana" ai_state="C" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="no community handling" ai_state="C" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="community handling all" ai_state="C" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="malaria policy implementation date" ai_state="C" access="input">
				<eqn>2027</eqn>
				<units>year</units>
			</aux>
			<aux name="initial community handling capability" ai_state="C" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="CHP malaria testing\nservice" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>person/year</units>
			</aux>
			<aux name="CHP malaria treatment\nservice" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>person/year</units>
			</aux>
			<aux name="CHP under five\ndiarrhoea visit\nservice" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>household/year</units>
			</aux>
			<aux name="CHP under five\ndiarrhoea treatment\nservice" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>person/year</units>
			</aux>
			<aux name="under five diarrhoea supplies gap" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>(CHP_under_five_diarrhoea_visit_service 
* person_per_urgent_visit) - CHP_under_five_diarrhoea_treatment_service</eqn>
				<units>person/year</units>
			</aux>
			<aux name="total unmet demand and trust gap" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>NAN</eqn>
				<units>person/year</units>
			</aux>
			<aux name="emergency visit %" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>100*CHP_emergency_first_aid_injuries_service_1/sum_service_and_unmet_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name='fever visit %"' ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>100*CHP_fever_visit_service_1/sum_service_and_unmet_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="routine visit %" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>100*CHP_routine_household_visits_per_year_1/sum_service_and_unmet_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="unmet need % - trust" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>100*unmet_need_households_due_to_lack_of_CHP_trust/sum_service_and_unmet_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="unmet demand % - CHPs" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>100*unmet_demand_in_households_visited_due_to_CHP_resource_gap/sum_service_and_unmet_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="unmet demand % - supplies" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>100*unmet_demand_due_to_supplies_gap/sum_service_and_unmet_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sum service and unmet demand" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_emergency_first_aid_injuries_service + CHP_fever_visit_service + CHP_routine_household_visits_per_year + CHP_under_five_diarrhoea_visit_service + unmet_demand_due_to_supplies_gap + unmet_demand_in_households_visited_due_to_CHP_resource_gap + unmet_need_households_due_to_lack_of_CHP_trust</eqn>
				<isee:summing/>
				<units>household/year</units>
			</aux>
			<aux name="CHP routine\nhousehold\nvisits per year 1" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>household/year</units>
			</aux>
			<aux name="CHP under five\ndiarrhoea visit\nservice 1" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>household/year</units>
			</aux>
			<aux name="CHP fever visit\nservice 1" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>household/year</units>
			</aux>
			<aux name="CHP emergency first\naid injuries service 1" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>household/year</units>
			</aux>
			<aux name="&lt;5 diarrhoea visit %" ai_state="F">
				<dimensions>
					<dim name="area"/>
