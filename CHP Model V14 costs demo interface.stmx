					<eqn>954785</eqn>
				</element>
				<element subscript="Turkana_West">
					<eqn>246816</eqn>
				</element>
				<element subscript="Suguta">
					<eqn>28995</eqn>
				</element>
				<element subscript="Uasin_Gishu">
					<eqn>1183030</eqn>
				</element>
				<element subscript="Kapseret">
					<eqn>203263</eqn>
				</element>
				<element subscript="Soy">
					<eqn>234592</eqn>
				</element>
				<element subscript="Turbo">
					<eqn>215459</eqn>
				</element>
				<units>person</units>
			</aux>
			<aux name="population by age group Kenya" ai_state="B">
				<dimensions>
					<dim name="age_group"/>
				</dimensions>
				<eqn>NAN</eqn>
				<units>person</units>
			</aux>
			<aux name="population by area" ai_state="F" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>SUM(population_by_age_group_area[*,area])</eqn>
				<units>person</units>
			</aux>
			<aux name="population total Kenya" ai_state="B">
				<eqn>NAN</eqn>
				<units>person</units>
			</aux>
			<aux name="population proportion by age group Kenya" ai_state="B">
				<doc>population_by_age_group_Kenya[age_group]/population_total_Kenya*area_age_group_adjustment[age_group,area]</doc>
				<dimensions>
					<dim name="age_group"/>
					<dim name="area"/>
				</dimensions>
				<eqn>population_by_age_group_Kenya[age_group]
/population_total_Kenya</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="population\nby age\ngroup area" ai_state="B" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="age_group"/>
					<dim name="area"/>
				</dimensions>
				<eqn>initial_population_by_area[area]
*initial_proportion_of_area_pop_by_age_group[age_group,area]
*pop_multiplier_by_age_group_Kenya[age_group]</eqn>
				<units>person</units>
			</aux>
			<aux name="crude death rate" ai_state="B">
				<eqn>1</eqn>
				<units>1/year</units>
			</aux>
			<stock name="Kenya population stock from UNPOP rates for comparison" ai_state="B">
				<eqn>initial_population_Kenya</eqn>
				<inflow>births</inflow>
				<outflow>deaths</outflow>
				<non_negative/>
				<units>person</units>
			</stock>
			<flow name="births" ai_state="B">
				<eqn>Kenya_population_stock_from_UNPOP_rates_for_comparison*crude_birth_rate/1000</eqn>
				<non_negative/>
				<units>person/year</units>
			</flow>
			<flow name="deaths" ai_state="B">
				<eqn>Kenya_population_stock_from_UNPOP_rates_for_comparison*crude_death_rate/1000</eqn>
				<non_negative/>
				<units>person/year</units>
			</flow>
			<aux name="crude birth rate" ai_state="B">
				<eqn>NAN</eqn>
				<units>1/year</units>
			</aux>
			<aux name="total community demand\nper year for household\nvisits by service and area" ai_state="B">
				<doc>population_by_area[area]*
visit_frequency_by_service[emergency_and_first_aid]
+
population_by_age_group_area[under_1,area]*1.26

mal.malaria_testing_forecast_full_demand[area]

mal.malaria_treatment_forecast_full_demand[area]


removed 
*household_size[area] from routine calcs</doc>
