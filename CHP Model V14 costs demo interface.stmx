	</model>
	<model name="Costs">
		<variables>
			<aux name="cost per CHP training hour" ai_state="F">
				<doc>From spreadsheet sample documentation</doc>
				<eqn>319</eqn>
				<units>KES/CHP</units>
			</aux>
			<aux name="cost of supplies\nby item" ai_state="B">
				<dimensions>
					<dim name="supplies"/>
				</dimensions>
				<eqn>1</eqn>
				<units>KES/item</units>
			</aux>
			<aux name="Supplies cost of service" ai_state="D">
				<doc>+
(.item_per_service_unit[service]*cost_of_supplies[service]))</doc>
				<dimensions>
					<dim name="supplies"/>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_deworming_visit_service[area]*item_per_child_dewormed*cost_of_supplies_by_item[deworming]</eqn>
				<units>KES/year</units>
			</aux>
			<aux name="CHP deworming visit\nservice" ai_state="B" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>person/year</units>
			</aux>
			<aux name="item per child dewormed" ai_state="B">
				<eqn>1</eqn>
				<units>item/person</units>
			</aux>
			<aux name="training and\nsupervision investment\nhours per CHP per year" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>5</eqn>
				<units>1/year</units>
			</aux>
			<aux name="new CHP inflow" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>CHP/year</units>
			</aux>
			<stock name="CHPs\nby area" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>CHP</units>
			</stock>
			<aux name="unit cost of CHP\nrecruitment and\ninitial training" ai_state="F">
				<eqn>67142</eqn>
				<units>KES/CHP</units>
			</aux>
			<aux name="unit cost of a CHP for a year\nincluding annual training plus supplies" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>unit_cost_of_CHP_annual_stipend_plus_CHEW_portion 
+
(all_supplies_unit_cost *
proportion_of_supplies_available[general])
+ 
unit_training_cost[area]</eqn>
				<units>KES/CHP/year</units>
			</aux>
			<aux name="cost of new CHPs" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>new_CHP_inflow*
(unit_cost_of_CHP_recruitment_and_initial_training +
unit_cost_of_initial_supplies_and_phone)</eqn>
				<units>KES/year</units>
			</aux>
			<aux name="item per malaria test" ai_state="F">
				<eqn>1</eqn>
				<units>KES</units>
			</aux>
			<aux name="item per malaria treatment" ai_state="F">
				<eqn>1</eqn>
				<units>KES</units>
			</aux>
			<aux name="unit cost of annual consumables" ai_state="F">
				<eqn>8338</eqn>
				<units>KES/CHP/year</units>
			</aux>
			<aux name="unit cost of CHP annual\nstipend plus CHEW portion" ai_state="F">
				<eqn>7940</eqn>
				<units>KES/CHP/year</units>
			</aux>
			<aux name="unit cost annual phone and bundle" ai_state="F">
				<eqn>7865</eqn>
				<units>KES/CHP/year</units>
			</aux>
			<aux name="unit cost of initial supplies and phone" ai_state="F">
				<eqn>69384</eqn>
				<units>KES/CHP</units>
			</aux>
			<aux name="unit cost of equipment replacement" ai_state="F">
				<eqn>13096</eqn>
				<units>KES/CHP/year</units>
			</aux>
			<aux name="CHP annual service cost by area" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_stipend_and_CHEW_supervision_by_area
+
supplies_total_cost_by_area
+
 training_total_cost_by_area</eqn>
				<units>KES/year</units>
			</aux>
			<aux name="total costs of CHPs with recruitment by area" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_annual_service_cost_by_area +
cost_of_new_CHPs</eqn>
				<units>KES/year</units>
			</aux>
			<aux name="proportion of\nsupplies\navailable" ai_state="F" access="input">
				<dimensions>
					<dim name="supplies"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="training\nstart year" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>2027</eqn>
				<units>year</units>
			</aux>
			<aux name="unit training cost" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>IF TIME &gt;=training_start_year
THEN 
training_and_supervision_investment_hours_per_CHP_per_year *cost_per_CHP_training_hour

ELSE base_training_hours_per_CHP_per_year*cost_per_CHP_training_hour</eqn>
				<units>KES/CHP/year</units>
			</aux>
			<aux name="CHP cost per head\npopulation" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_annual_service_cost_by_area / population_by_area</eqn>
				<units>KES/person/year</units>
			</aux>
			<aux name="population by area" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>person</units>
			</aux>
			<aux name="all supplies unit cost" ai_state="F">
				<eqn>(unit_cost_of_equipment_replacement +
unit_cost_of_annual_consumables) 
* proportion_of_supplies_available[general]</eqn>
				<units>KES/CHP/year</units>
			</aux>
			<aux name="supplies total cost\nby area" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHPs_by_area *
all_supplies_unit_cost</eqn>
				<units>KES/year</units>
			</aux>
			<aux name="training total cost\nby area" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHPs_by_area *
unit_training_cost</eqn>
				<units>KES/year</units>
			</aux>
			<aux name="CHP stipend and\nCHEW supervision\nby area" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHPs_by_area *
unit_cost_of_CHP_annual_stipend_plus_CHEW_portion</eqn>
				<units>KES/year</units>
			</aux>
			<aux name="people costs\nby area" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_stipend_and_CHEW_supervision_by_area
+ training_total_cost_by_area</eqn>
				<units>KES/year</units>
			</aux>
			<aux name="base training hours per CHP per year" ai_state="F">
				<eqn>5</eqn>
				<units>1/year</units>
			</aux>
			<aux name="CHP demand\nby area" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>person</units>
			</aux>
			<aux name="CHP cost per head\ntarget population" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_annual_service_cost_by_area / CHP_demand_by_area</eqn>
				<units>KES/person/year</units>
			</aux>
			<aux name="phone total cost\nby area" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHPs_by_area *
unit_cost_annual_phone_and_bundle</eqn>
				<units>KES/year</units>
			</aux>
		</variables>
