			<view isee:template_view="template:9" isee:name="Resourcing scenarios" isee:original_design="Deluxe Prev-Next Blue Green Pastel" background="white" page_width="1066" page_height="600" type="interface">
				<style>
					<isee:stacked_container item_spacing="0" corner_radius="4" selected_item_color="black" selected_item_background="white" item_background="#DDDDDD" transparent_bg="false"/>
				</style>
				<text_box font_size="18pt" border_color="#00557F" border_width="2" border_style="solid" x="413.026" y="40.6082" width="306.537" height="25.0588">CHP resource gap scenario summary 
summary</text_box>
				<text_box font_size="13pt" border_color="#00557F" border_width="2" border_style="solid" x="12.9231" y="74.1541" width="381" height="457.514">This summary of CHP supply and demand in Kenya shows demand from 2024 for approximately 120,000 CHPs, shown by green line A.

Blue line B represents the base case - recruitment to current replacement levels only, with an erosion of skills after initial training and 5 hours of supervision provided per year (half an hour in 10 months out of 12 months). 50% of the needed supplies are available to the CHP cadre.

Recruitment of 2% additional CHPs from 2026 reduces the demand gap - yellow line C shows the effect. Delaying recruitment uplift to 2028 produces a slower growth in CHP resource - blue line D shows the effect.

Training and additional supervision of 15 hours per year from 2027 closes the demand gap - pink line E shows the effect. 

Recruitment of 2% additional CHPs with 15 hours additional training closes the demand gap - purple line F shows the effect.

Increasing supplies to 100% improves CHP motivation. Red line G shows the effect combined with recruitment of 2% additional CHPs and 15 hours per year training/supervision.

There are many combinations and these can be explored for each subcounty or county in Dashboard 1 by pressing the &apos;Dashboard&apos; tab.</text_box>
				<stacked_container x="416.332" y="113" width="611.334" height="418.667" z_index="6" isee:appearance="tabs">
					<graph axis_label_font_size="16pt" width="611.334" height="418.667" type="time_series" show_grid="false" isee:tick_type="none" include_units_in_legend="false" isee:marker_type="letters" isee:label_pie_slices="false" isee:show_pie_borders="true" num_x_grid_lines="0" num_y_grid_lines="0" num_x_labels="5" num_y_labels="6" title="CHP service gap - below the line needs are met, above the line some needs unfulfilled" isee:page_title="Whole of Kenya" isee:fill_intensity="0.1" from="2024" isee:allow_zero_axis="true" left_axis_title="CHP numbers " left_axis_multi_scale="false" left_axis_auto_scale="true" left_include_units="true" right_axis_multi_scale="false" right_axis_auto_scale="true" right_include_units="true">
						<plot color="#00AA00" title="Demand for CHPs in number of CHPs" isee:keep_zero_visible="true" pen_width="2" index="0" show_y_axis="true">
							<entity name="CHP_numbers_2025_equivalent[Kenya]"/>
							<isee:data name="CHP numbers demand"/>
						</plot>
						<plot color="blue" title="CHP capacity base case - no recruitment, 5 hrs supervision per year, 50% supplies available" isee:keep_zero_visible="true" pen_width="2" index="1" show_y_axis="true">
							<entity name="CHP_numbers_2025_equivalent[Kenya]"/>
							<isee:data name="Base case 5 hours supervision pa, zero recruitment, 50% supplies"/>
						</plot>
						<plot color="#FFAA00" pen_style="dashed" title="CHP capacity - recruit 2% above replacement, 5 hours training/supervision per year, 50% supplies" isee:keep_zero_visible="true" pen_width="1" index="2" show_y_axis="true">
							<entity name="CHP_numbers_2025_equivalent[Kenya]"/>
						</plot>
						<plot color="fuchsia" pen_style="dotted" title="CHP capacity - recruit to replace, 15 hrs supervision, 50% supplies" isee:keep_zero_visible="true" pen_width="1" index="3" show_y_axis="true">
							<entity name="CHP_numbers_2025_equivalent[Kenya]"/>
							<isee:data name="Recruit to replace attrition, 15 hrs training/supervision pa, 50% supplies"/>
						</plot>
						<plot color="#AA00FF" pen_style="dot_dashed" title="CHP capacity - recruit 2% above replacement, 15 hours training/supervision per year, 50% supplies" isee:keep_zero_visible="true" pen_width="1" index="4" show_y_axis="true">
							<entity name="CHP_numbers_2025_equivalent[Kenya]"/>
							<isee:data name="Recruit 2% above attrition, 15 hrs training/supervision pa, 50% supplies"/>
						</plot>
						<plot color="red" pen_style="dotted" title="CHP capacity - recruit 2% above replacement, 15 hours training/supervision per year, 100% supplie" isee:keep_zero_visible="true" pen_width="1" index="5" show_y_axis="true">
							<entity name="CHP_numbers_2025_equivalent[Kenya]"/>
