(population_by_age_group_area[under_1,area]+population_by_age_group_area[&quot;1_to_4&quot;,area])</eqn>
				<units>1/year</units>
			</aux>
			<aux name="population\nby age\ngroup area" ai_state="D" access="input">
				<dimensions>
					<dim name="age_group"/>
					<dim name="area"/>
				</dimensions>
				<eqn>initial_population_by_area[area]
*initial_proportion_of_area_pop_by_age_group[age_group,area]
*pop_multiplier_by_age_group_Kenya[age_group]</eqn>
				<units>person</units>
			</aux>
			<aux name="CHP under 2 months\nassessed" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>NAN</eqn>
