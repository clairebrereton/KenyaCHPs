	</model>
	<model name="maltrt">
		<variables>
			<aux name="CHP malaria testing\nservice" ai_state="H" access="output" isee:autocreated="true">
				<doc>MIN(CHP_fever_visit_service[area]*mal.community_handling_capability[area], remaining_supply_capacity_in_service_units[malaria_testing,area])

</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_fever_visit_service*person_per_urgent_visit_1
*community_handling_capability_1
*proportion_of_supplies_available[malaria_test]*proportion_of_hh_visits_requiring_supplies[malaria_test,area]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="CHP malaria treatment\nservice" ai_state="H" access="output" isee:autocreated="true">
				<doc>Explanation 
IF constrained by test supply CAPACITY THEN 
IF tested plus untested greater than treatment capacity then treat to treatment capacity ELSE use tested plus untested and treat to visit capacity 

If not constrained by test supply then treat all positive 


IF CHP_malaria_testing_service &gt; remaining_supply_capacity_in_service_units[malaria_testing,area]

THEN 
MIN(CHP_malaria_testing_service[area]*mal.community_handling_capability*positive_proportion_of_malaria_cases[area],  remaining_supply_capacity_in_service_units[malaria_treatment,area])

ELSE

MIN(CHP_fever_visit_service[area]*mal.community_handling_capability[area],  remaining_supply_capacity_in_service_units[malaria_treatment,area])


CHP_malaria_testing_service*positive_proportion_of_malaria_cases*.proportion_of_supplies_available[malaria_treat]*.proportion_of_hh_visits_requiring_supplies[malaria_treat,area]
+
.CHP_fever_visit_service*pop.person_per_urgent_visit
*mal.community_handling_capability
*(1-.proportion_of_supplies_available[malaria_test])
*.proportion_of_supplies_available[malaria_treat]*.proportion_of_hh_visits_requiring_supplies[malaria_treat,area]</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_malaria_testing_service*positive_proportion_of_malaria_cases*proportion_of_supplies_available[malaria_treat]*proportion_of_hh_visits_requiring_supplies[malaria_treat,area]
+

CHP_fever_visit_service*person_per_urgent_visit_1
*community_handling_capability_1
*(1-proportion_of_supplies_available[malaria_test])
*proportion_of_supplies_available[malaria_treat]*proportion_of_hh_visits_requiring_supplies[malaria_treat,area]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="positive proportion\nof malaria cases" ai_state="F" access="output" isee:autocreated="true">
				<doc>get realistic value. This based on Omondi et al average doi: 10.1371/journal.pgph.0001532

Now based on KHIS CHEW Malaria test positivity rate (by RDT)</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<element subscript="Kenya">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Kakamega">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Butere">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Mumias_West">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Shinyalu">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Nairobi">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Kibra">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Turkana">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Turkana_West">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Suguta">
					<eqn>0.5</eqn>
				</element>
				<element subscript="Uasin_Gishu">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Kapseret">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Soy">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Turbo">
					<eqn>0.4</eqn>
				</element>
				<units>dmnl</units>
			</aux>
			<aux name="CHP malaria\ntest and treat" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_malaria_testing_service
+
CHP_malaria_treatment_service</eqn>
				<units>person/year</units>
			</aux>
			<aux name="overtreatment\nproportion" ai_state="F">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>IF CHP_malaria_treatment_service[area]=0
THEN 0 
ELSE SAFEDIV(CHP_malaria_treatment_service,CHP_valid_malaria_treatment_service)-1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="CHP valid malaria treatment\nservice" ai_state="H" access="output" isee:autocreated="true">
				<doc>Explanation 
IF constrained by test supply CAPACITY THEN 
IF tested plus untested greater than treatment capacity then treat to treatment capacity ELSE use tested plus untested and treat to visit capacity 

If not constrained by test supply then treat all positive 


IF CHP_malaria_testing_service &gt; remaining_supply_capacity_in_service_units[malaria_testing,area]

THEN 
MIN(CHP_malaria_testing_service[area]*mal.community_handling_capability*positive_proportion_of_malaria_cases[area],  remaining_supply_capacity_in_service_units[malaria_treatment,area])

ELSE

MIN(CHP_fever_visit_service[area]*mal.community_handling_capability[area],  remaining_supply_capacity_in_service_units[malaria_treatment,area])</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>CHP_malaria_testing_service*positive_proportion_of_malaria_cases*proportion_of_supplies_available[malaria_treat]*proportion_of_hh_visits_requiring_supplies[malaria_treat,area]
+
CHP_fever_visit_service*person_per_urgent_visit_1
*community_handling_capability_1*positive_proportion_of_malaria_cases
*(1-proportion_of_supplies_available[malaria_test])
*proportion_of_supplies_available[malaria_treat]*proportion_of_hh_visits_requiring_supplies[malaria_treat,area]</eqn>
				<units>person/year</units>
			</aux>
			<aux name="community\nhandling capability 1" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="proportion of\nsupplies\navailable" ai_state="F" access="input">
				<dimensions>
					<dim name="supplies"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="proportion of hh visits\nrequiring supplies" ai_state="F" access="input">
				<dimensions>
					<dim name="supplies"/>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="CHP fever visit\nservice" ai_state="F" access="input">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>household/year</units>
			</aux>
			<aux name="person per urgent visit 1" ai_state="F" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>person/household</units>
			</aux>
		</variables>
