			<stock name="malaria prevalence" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>base_malaria_prevalence[area]</eqn>
				<outflow>prevalence_rate_change</outflow>
				<non_negative/>
				<units>dmnl</units>
			</stock>
			<flow name="prevalence rate change" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>malaria_prevalence*Decay_fraction</eqn>
				<non_negative/>
				<units>1/year</units>
			</flow>
			<aux name="Decay fraction" ai_state="B">
				<doc>exponential decay. Multiplier calibrated from evidence papers Kakamega</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>proportion_treated_in_community[area]*decay_fraction_multiplier</eqn>
				<units>1/year</units>
			</aux>
			<aux name="suspected malaria\ncases total reported\nin community" ai_state="B" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>NAN</eqn>
				<units>case</units>
			</aux>
			<aux name="decay fraction multiplier" ai_state="F">
				<eqn>0.25</eqn>
				<units>1/year</units>
			</aux>
			<aux name="malaria prevalence compare" ai_state="B">
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<eqn>malaria_prevalence</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="community\nhandling capability" ai_state="B" access="output" isee:autocreated="true">
				<doc>IF TIME &lt;2027
THEN initial_community_handling_capability
ELSE 0.9</doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<element subscript="Kenya">
					<eqn>IF
community_handling_lake_endemic=1
THEN initial_community_handling_capability
ELSE 
   IF (community_handling_lake_endemic_coastal_endemic_and_Turkana=1 AND TIME &gt;= malaria_policy_implementation_date)
   THEN 0.31 
   ELSE 
         IF (no_community_handling=1 AND TIME &gt;= malaria_policy_implementation_date)
         THEN 0
         ELSE 
              IF (community_handling_all=1 AND TIME &gt;= malaria_policy_implementation_date)
              THEN 0.9
              ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Kakamega">
					<eqn>IF
community_handling_lake_endemic=1
THEN initial_community_handling_capability
ELSE 
   IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1
   THEN initial_community_handling_capability
   ELSE 
         IF (no_community_handling=1 AND TIME &gt;= malaria_policy_implementation_date)
         THEN 0
         ELSE 
              IF community_handling_all=1
              THEN initial_community_handling_capability
              ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Butere">
					<eqn>IF
community_handling_lake_endemic=1
THEN initial_community_handling_capability
ELSE 
   IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1
   THEN initial_community_handling_capability
   ELSE 
         IF (no_community_handling=1 AND TIME &gt;= malaria_policy_implementation_date)
         THEN 0
         ELSE 
              IF community_handling_all=1
              THEN initial_community_handling_capability
              ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Mumias_West">
					<eqn>IF
community_handling_lake_endemic=1
THEN initial_community_handling_capability
ELSE 
   IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1
   THEN initial_community_handling_capability
   ELSE 
         IF (no_community_handling=1 AND TIME &gt;= malaria_policy_implementation_date)
         THEN 0
         ELSE 
              IF community_handling_all=1
              THEN initial_community_handling_capability
              ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Shinyalu">
					<eqn>IF
community_handling_lake_endemic=1
THEN initial_community_handling_capability
ELSE 
   IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1
   THEN initial_community_handling_capability
   ELSE 
         IF (no_community_handling=1 AND TIME &gt;= malaria_policy_implementation_date)
         THEN 0
         ELSE 
              IF community_handling_all=1
              THEN initial_community_handling_capability
              ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Nairobi">
					<eqn>IF
community_handling_lake_endemic=1
THEN 0
ELSE 
   IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1
   THEN 0
   ELSE 
         IF no_community_handling=1
         THEN 0
         ELSE 
              IF (community_handling_all=1 AND TIME &gt;= malaria_policy_implementation_date)
              THEN 0.9
              ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Kibra">
					<eqn>IF
community_handling_lake_endemic=1
THEN 0
ELSE 
   IF community_handling_lake_endemic_coastal_endemic_and_Turkana=1
   THEN 0
   ELSE 
         IF no_community_handling=1
         THEN 0
         ELSE 
              IF (community_handling_all=1 AND TIME &gt;= malaria_policy_implementation_date)
              THEN 0.9
              ELSE initial_community_handling_capability</eqn>
				</element>
				<element subscript="Turkana">
					<eqn>IF
community_handling_lake_endemic=1
THEN initial_community_handling_capability
ELSE 
   IF (community_handling_lake_endemic_coastal_endemic_and_Turkana=1 AND TIME &gt;= malaria_policy_implementation_date)
   THEN 0.9
   ELSE 
         IF no_community_handling=1
         THEN 0
         ELSE 
              IF (community_handling_all=1 AND TIME &gt;= malaria_policy_implementation_date)
              THEN 0.9
              ELSE initial_community_handling_capability</eqn>
				</element>
