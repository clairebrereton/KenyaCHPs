			</module>
			<aux name="emergency household\nvisit equivalent multiplier" ai_state="B">
				<eqn>8</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="visit frequency" ai_state="B">
				<eqn>9</eqn>
				<units>1/year</units>
			</aux>
			<aux name="target households" ai_state="B">
				<doc>Turkana West remote. 25 households per CHP. But refugees in camps are 40-50% of total at 50 households per CHP. 
So assume 35 households per CHP.

Suguta assume 31 households per CHP  </doc>
				<dimensions>
					<dim name="area"/>
				</dimensions>
				<element subscript="Kenya">
					<eqn>100</eqn>
				</element>
				<element subscript="Kakamega">
					<eqn>100</eqn>
				</element>
				<element subscript="Butere">
