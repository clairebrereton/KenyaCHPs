				<connect2 to="cut_down_service_unit_needs_per_year_by_area" from="pop.target_household_visit_demand_per_year_by_area"/>
				<connect to="pop.diarrhoea_treatment_demand_proportion" from=".diarrhoea_treatment_demand_proportion"/>
				<connect2 to="pop.diarrhoea_treatment_demand_proportion" from="diarrhoea_treatment_demand_proportion"/>
				<connect to="pop.emergency_household_visit_equivalent_multiplier" from=".emergency_household_visit_equivalent_multiplier"/>
