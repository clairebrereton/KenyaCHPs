				<text_box z_index="7" background="#C9D2D8" font_color="#3D405B" font_size="14pt" padding="5" border_color="#3D405B" border_width="thick" vertical_scrollbar="true" appearance="transparent" x="61.9147" y="173.742" width="374.185" height="362.569">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
